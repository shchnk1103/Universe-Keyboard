    "supported_schema": {"major": 1, "minor": 0},
    "record_roots": [
      "docs/assignments",
      "docs/product-decisions",
      "docs/evidence",
      "docs/authorizations",
      "docs/gates",
      "docs/kos/upgrade-records"
    ],
    "include": [
      "docs/assignments/kos-upgrade-uk-001.md",
      "docs/assignments/kos-upgrade-uk-003.md",
