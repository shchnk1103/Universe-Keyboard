{
  "xcode": {
    "argv": [
      "xcodebuild",
      "-version"
    ],
    "exit": 0,
    "stdout": "Xcode 27.0\nBuild version 27A266a\n",
    "stderr": ""
  },
  "developer": {
    "argv": [
      "xcode-select",
      "-p"
    ],
    "exit": 0,
