  "swift": {
    "argv": [
      "xcrun",
      "swiftc",
      "--version"
    ],
    "exit": 0,
    "stdout": "Apple Swift version 6.4 (swiftlang-6.4.0.34.1 clang-2100.3.34.1)\nTarget: arm64-apple-macosx27.0.0\n",
