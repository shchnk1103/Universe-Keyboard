# TD-012 G1: locked inputs for the reproducible iOS octagram static plugin.
# This file is the Source of Truth for build pins. Do not float on upstream HEAD.

# Baseline vendor retained as immutable ABI / dependency binary source.
BASELINE_RIME_VENDOR_VERSION="rime-vendor-ios-1.16.1-lua.1"
BASELINE_RIME_VENDOR_ARCHIVE_SHA256="c299f36eae4966a8c22f83046c7015a04b3f047abcc4bab9355ca19ac840436c"

# librime public commit whose device+simulator librime.a match the baseline pin
# byte-for-byte (verified 2026-08-09).
LIBRIME_GIT_URL="https://github.com/rime/librime.git"
LIBRIME_GIT_COMMIT="1300e568967feeeedd72028c7cb5ef9151f7fb37"

# Product-authorized octagram source: relicense merge commit (BSD-3-Clause root
# LICENSE). Stale GPLv3 file header residual is recorded in provenance notice.
OCTAGRAM_GIT_URL="https://github.com/lotem/librime-octagram.git"
OCTAGRAM_GIT_COMMIT="bfb168ca33d8b372596fdf2007933f3da1cf360e"

# Header-only Boost used by librime / octagram compile. Libraries come from the
# baseline vendor xcframeworks, not from this tree.
BOOST_VERSION="1.91.0"
BOOST_TARBALL_URL="https://archives.boost.io/release/1.91.0/source/boost_1_91_0.tar.bz2"
BOOST_TARBALL_SHA256="de5e6b0e4913395c6bdfa90537febd9028ea4c0735d2cdb0cd9b45d5f51264f5"
BOOST_ROOT_DIRNAME="boost_1_91_0"

# Artifact / toolchain contract for the new plugin slices.
IOS_DEPLOYMENT_TARGET="15.0"
PLUGIN_XCFRAMEWORK_NAME="librime-octagram.xcframework"
PLUGIN_STATIC_ARCHIVE_NAME="librime-octagram.a"

# Output vendor identity (immutable; never overwrite baseline tag).
OUTPUT_RIME_VENDOR_VERSION="rime-vendor-ios-1.16.1-lua.1-octagram.1"
OUTPUT_RIME_VENDOR_ARCHIVE_NAME="universe-keyboard-rime-vendor-ios-1.16.1-lua.1-octagram.1.zip"
